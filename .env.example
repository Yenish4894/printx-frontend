# ─────────────────────────────────────────────────────────────
# Bhagini Graphics — environment variables
# Copy to `.env` for local dev, or set these in your Vercel project.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon serverless Postgres) — REQUIRED ──
# Neon dashboard → Connect → pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Auth — REQUIRED ──
# A long random secret for signing session JWTs. Generate: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# ── Payments (Razorpay) — OPTIONAL ──
# When set, wallet top-ups go through Razorpay checkout. When unset, the app
# falls back to manual instant credit (DEV ONLY — do not ship without these).
# Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Same key id, exposed to the browser to open checkout (must be prefixed NEXT_PUBLIC_).
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── File storage (S3-compatible: Cloudflare R2 or AWS S3) — OPTIONAL ──
# When all four are set, uploaded artwork is stored in object storage. When
# unset, files go to local disk (DEV ONLY — not persistent on serverless).
S3_BUCKET=""
S3_ENDPOINT=""            # R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  |  S3: https://s3.<region>.amazonaws.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"         # R2: "auto"  |  AWS: your bucket region e.g. "ap-south-1"
