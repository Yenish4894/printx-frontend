# ─────────────────────────────────────────────────────────────
# Bhagini Graphics — environment variables
# Copy to `.env` for local dev. In production, set these as Cloudflare Worker secrets.
# ─────────────────────────────────────────────────────────────

# ── Database (Neon serverless Postgres) — REQUIRED ──
# Neon dashboard → Connect → pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Auth — REQUIRED ──
# A long random secret for signing session JWTs. Generate: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# ── File storage ──
# Nothing to set here. On Cloudflare, uploads (artwork, payment screenshots, product
# photos) use the R2 bucket bound as `UPLOADS` in wrangler.jsonc (see CLOUDFLARE_DEPLOY.md).
# In local `npm run dev`, files are written to ./uploads (dev only, not persistent).
