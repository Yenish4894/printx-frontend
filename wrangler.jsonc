{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printx-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  // nodejs_compat: run the Node APIs the app uses (crypto, path, Buffer, streams).
  // global_fetch_strictly_public: OpenNext's internal self-fetches go over the public edge.
  // no_handle_cross_request_promise_resolution: the shared Prisma client's fetch-based
  //   queries resolve promises across request contexts; without this Workers cancels them.
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
    "no_handle_cross_request_promise_resolution"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "printx-frontend"
    }
  ]

  // ── Add when you wire the deferred integrations ──
  // R2 bucket for file uploads (our storage.ts S3 seam talks to it):
  // "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "printx-uploads" }]
  //
  // Secrets are NOT set here — add them with `wrangler secret put NAME`
  // (DATABASE_URL, JWT_SECRET, and later RAZORPAY_*, S3_*).
}
