// Bhagini Graphics — Prisma schema
// Models mirror FINALIZED_FLOW.md. Money stored as Decimal(10,2).
// Auth = mobile + password. Orders = prepaid by bank transfer. No offers/loyalty/ratings.
// The configurator (Product → SpecGroup → SpecOption + QuantityTier + DeliverySpeed
// + VisibilityRule) is fully dynamic: admin defines everything, no hardcoded specs.

// The app's client. Targets Cloudflare Workers: engine-free, WASM query
// compiler, edge runtime. This is the ONLY client the Worker bundles.
generator client {
  provider     = "prisma-client"
  runtime      = "cloudflare"
  moduleFormat = "esm"
  output       = "../src/generated/prisma"
}

// A second, Node-targeted client for scripts run on a developer machine (the
// seed). The Cloudflare client above cannot run under Node — its WASM compiler
// fails to initialise ("loaded wasm module was unexpectedly undefined") — so
// anything executed with node/tsx must import this one instead.
// Never imported by src/app or src/lib, so it never reaches the Worker bundle.
generator nodeClient {
  provider     = "prisma-client"
  runtime      = "nodejs"
  moduleFormat = "esm"
  output       = "../src/generated/prisma-node"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
}

// Self-registered customers start PENDING and cannot sign in until an admin
// approves them.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingModel {
  TIERED // base price by quantity tier
  PER_UNIT // unitRate × units (pcs / area)
  MATRIX // rate looked up from PriceMatrix by option combination × sheets (CMYK/stickers)
}

enum UnitType {
  PIECE
  SQ_FT
  SQ_CM
  SQ_INCH
  SQ_METER
}

enum SelectionType {
  SINGLE_SELECT
  MULTI_SELECT
}

enum AddOnType {
  FLAT // +₹X once
  PER_UNIT // +₹X × units
}

enum RuleTarget {
  GROUP
  OPTION
}

enum RuleOperator {
  IS
  IS_NOT
  IN
}

enum RuleLogic {
  AND
  OR
}

enum OrderStatus {
  // Created at checkout. The customer pays by bank transfer and uploads proof;
  // it leaves this state only when an admin approves that proof.
  PAYMENT_PENDING
  PLACED
  DESIGN_REVIEW
  PRINTING
  QUALITY_CHECK
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FileStatus {
  UPLOAD_PENDING
  UPLOADED
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER // customer transfers to the business account and uploads proof
}

enum PaymentPurpose {
  ORDER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  PENDING
  PROCESSING
  CREDITED
  REJECTED
}

enum NotificationType {
  ORDER
  SYSTEM
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id            String   @id @default(cuid())
  businessName  String
  ownerName     String
  mobile        String   @unique // login identifier
  email         String
  gstNumber     String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  isActive      Boolean   @default(true)
  // Defaults to APPROVED so every account that already exists, and every staff
  // account a super admin creates, is unaffected. Only the public signup route
  // sets PENDING.
  approvalStatus       ApprovalStatus @default(APPROVED)
  approvalReviewedAt   DateTime?
  approvalReviewedById String?
  approvalRejectReason String? // shown to the applicant when they try to sign in
  lastLoginAt   DateTime?
  // Sessions issued before this are dead: set when the user changes their password.
  passwordChangedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses           Address[]
  orders              Order[]
  cart                Cart?
  notifications       Notification[]
  refunds             Refund[]
  payments            Payment[]

  @@index([role]) // admin + stats queries all filter on role
  @@index([role, createdAt]) // customer and staff lists: by role, newest/oldest first
  @@index([role, approvalStatus]) // pending-signup count and the admin approval filter
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // "Home" / "Office"
  name      String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────── Catalog ─────────────────────────

// Two-level browse: a top category ("Letter Heads") holds sub-categories
// ("100 GSM Bond Paper"), and products hang off the leaf. `parentId` is null
// for top-level categories. Products may sit on either level.
model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  parentId     String?
  parent       Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  products     Product[]

  @@index([parentId])
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)

  // Pricing config
  pricingModel       PricingModel @default(TIERED)
  unitType           UnitType? // for PER_UNIT
  requiresDimensions Boolean      @default(false) // width × height inputs
  unitRate           Decimal?     @db.Decimal(10, 2) // for PER_UNIT
  minQuantity        Int          @default(1)
  maxQuantity        Int? // upper bound (e.g. 16000 letterheads); null = unbounded
  quantityStep       Int          @default(1) // orderable increment above minQuantity

  // Charged only when the customer asks us to design the artwork. Stored from the
  // rate card; NOT applied by the pricing engine yet (no design-service UI).
  additionalDesignCharge Decimal? @db.Decimal(10, 2)

  // MATRIX products (CMYK / stickers): rates are GST-inclusive, base = matrix rate × sheets
  pricesIncludeGst     Boolean  @default(false) // MATRIX rates already include GST
  singlePrintThreshold Int? // below this qty, flat singlePrintRate applies per sheet
  singlePrintRate      Decimal? @db.Decimal(10, 2) // e.g. ₹20/sheet for tiny orders

  // Display / metadata
  productCode       String? // "LH-3" — the code customers quote when ordering by phone
  productClass      String? // "Classic" / "Regular"
  productionTime    String? // "Within 48 hours from file upload"
  badges            String[] @default([]) // BESTSELLER / NEW / TRENDING / PREMIUM / ECO / POPULAR
  printTypeLabel    String? // "Full Color (CMYK)"
  standardSizeLabel String? // "85 × 55 mm"
  bleedArea         String? // "3mm on all sides"
  fileFormats       String[] @default([]) // PDF / AI / PSD / PNG
  basePriceFrom     Decimal? @db.Decimal(10, 2) // "From ₹X" display

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images          ProductImage[]
  priceMatrix     PriceMatrix[]
  specGroups      SpecGroup[]
  quantityTiers   QuantityTier[]
  deliverySpeeds  DeliverySpeed[]
  visibilityRules VisibilityRule[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId])
}

model ProductImage {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  @@index([productId])
}

// ── Dynamic spec configurator ──

model SpecGroup {
  id                 String        @id @default(cuid())
  productId          String
  product            Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String // "Paper Type" / "Material" / "Print Type" / "Finishing" …
  selectionType      SelectionType @default(SINGLE_SELECT)
  isPricingDimension Boolean       @default(false) // MATRIX: this group's options drive the rate
  // When true this group IS the order quantity: the selected option's
  // `quantityValue` becomes the line quantity (a fixed slab list — 1000 / 2000 /
  // … — rather than a free-typed number). At most one such group per product.
  isQuantityDimension Boolean      @default(false)
  isRequired         Boolean       @default(true)
  icon               String?
  displayOrder       Int           @default(0)
  isActive           Boolean       @default(true)

  options    SpecOption[]
  // rules whose CONDITION sources this group
  conditions RuleCondition[]  @relation("ConditionSourceGroup")
  // rule targeting this group (visibility)
  targetedBy VisibilityRule[] @relation("RuleTargetGroup")

  @@index([productId])
}

model SpecOption {
  id           String    @id @default(cuid())
  specGroupId  String
  specGroup    SpecGroup @relation(fields: [specGroupId], references: [id], onDelete: Cascade)
  name         String // "350gsm Matte"
  description  String? // "No glare"
  addOnType    AddOnType @default(FLAT)
  addOnValue   Decimal   @default(0) @db.Decimal(10, 2)
  perQuantity  Int       @default(1) // add-on charged per N units (e.g. 100 → ₹180 per 100 sheets)
  isDefault    Boolean   @default(false) // shown as "Included"
  isActive     Boolean   @default(true)
  displayOrder Int       @default(0)
  quantityValue Int? // set only on options of an isQuantityDimension group (e.g. 2000)
  code          String? // catalogue code customers quote, e.g. "601" for A4-80 GSM

  // rule targeting this option (visibility)
  targetedBy VisibilityRule[] @relation("RuleTargetOption")

  @@index([specGroupId])
}

model QuantityTier {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  basePrice    Decimal @db.Decimal(10, 2)
  label        String? // e.g. "Bulk discount applied"
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  @@index([productId])
}

model DeliverySpeed {
  id           String  @id @default(cuid())
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String // "Express" / "Standard" / "Economy"
  fee          Decimal @default(0) @db.Decimal(10, 2)
  etaMinDays   Int
  etaMaxDays   Int
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model VisibilityRule {
  id             String      @id @default(cuid())
  productId      String
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetType     RuleTarget
  targetGroupId  String?
  targetGroup    SpecGroup?  @relation("RuleTargetGroup", fields: [targetGroupId], references: [id], onDelete: Cascade)
  targetOptionId String?
  targetOption   SpecOption? @relation("RuleTargetOption", fields: [targetOptionId], references: [id], onDelete: Cascade)
  logic          RuleLogic   @default(AND)

  conditions RuleCondition[]

  @@index([productId])
}

model RuleCondition {
  id            String         @id @default(cuid())
  ruleId        String
  rule          VisibilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sourceGroupId String
  sourceGroup   SpecGroup      @relation("ConditionSourceGroup", fields: [sourceGroupId], references: [id], onDelete: Cascade)
  operator      RuleOperator   @default(IS)
  optionIds     String[] // SpecOption ids this condition matches against

  @@index([ruleId])
}

// MATRIX pricing: one row per valid combination of pricing-dimension options.
// Missing combinations are simply not orderable (e.g. Texture only on 12x18).
//
// A row prices its combination in exactly ONE of two ways — set one, leave the
// other null:
//   ratePerSheet  base = rate × quantity.  Quantity is free-typed and is NOT a
//                 pricing dimension. Used by CMYK / stickers.
//                 e.g. { Size:12x18, GSM:100, Sides:1 } → ₹8/sheet, GST-inclusive.
//   flatPrice     base = the price itself. Quantity IS a pricing dimension, so
//                 the combination already names it. Used by letterheads, whose
//                 card prices whole runs (3000 sheets → ₹3389) at rates that do
//                 not divide into an exact per-sheet figure.
model PriceMatrix {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  comboKey     String // normalized sorted option ids: "optA|optB|optC"
  optionIds    String[] // the pricing-dimension option ids in this combo
  ratePerSheet Decimal? @db.Decimal(10, 2) // per-sheet rate (× quantity)
  flatPrice    Decimal? @db.Decimal(10, 2) // total for the whole combination
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@unique([productId, comboKey])
  @@index([productId])
}

// ───────────────────────── Commerce ─────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id              String         @id @default(cuid())
  cartId          String
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id])
  quantity        Int
  width           Decimal?       @db.Decimal(10, 2) // PER_UNIT area products
  height          Decimal?       @db.Decimal(10, 2)
  deliverySpeedId String?
  deliverySpeed   DeliverySpeed? @relation(fields: [deliverySpeedId], references: [id])
  config          Json // { groupId: optionId | [optionIds] }
  specSnapshot    Json // [{ group, option, addOn }] resolved for display
  unitPrice       Decimal        @db.Decimal(10, 2)
  lineSubtotal    Decimal        @db.Decimal(10, 2) // taxable value of the line (pre-GST print charge)
  gstAmount       Decimal        @default(0) @db.Decimal(10, 2)
  fileUrl         String?
  fileName        String?
  fileStatus      FileStatus     @default(UPLOAD_PENDING)
  notes           String?
  createdAt       DateTime       @default(now())

  @@index([cartId])
  @@index([productId])
  @@index([fileUrl]) // ownership lookup for GET /api/files/[key]
}

// ───────────────────────── Orders ─────────────────────────

model Order {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  orderNumber   String      @unique // PX-2024-08471
  invoiceNumber String?     @unique // INV-2024-08471
  status        OrderStatus @default(PLACED)

  subtotal       Decimal @db.Decimal(10, 2)
  deliveryCharge Decimal @default(0) @db.Decimal(10, 2)
  gstAmount      Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  // Paid by bank transfer: see Payment. Created as PAYMENT_PENDING (the DB
  // default below predates that and is never relied on; code sets it).
  shippingSnapshot Json // address snapshot at order time
  notes            String?

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  refunds       Refund[]
  payment       Payment?

  @@index([userId])
  @@index([status]) // admin order list filters by status
  @@index([placedAt]) // every order list sorts newest-first
  @@index([status, placedAt]) // admin filters by status AND sorts by date in one query
  @@index([userId, placedAt]) // "my orders, newest first"
}

model OrderItem {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  productName      String // snapshot
  quantity         Int
  width            Decimal?       @db.Decimal(10, 2)
  height           Decimal?       @db.Decimal(10, 2)
  deliverySpeedId  String?
  deliverySpeed    DeliverySpeed? @relation(fields: [deliverySpeedId], references: [id])
  deliveryEtaLabel String? // "8 Jun 2024 · 2–3 business days"
  config           Json
  specSnapshot     Json
  unitPrice        Decimal        @db.Decimal(10, 2)
  lineSubtotal     Decimal        @db.Decimal(10, 2) // taxable value of the line (pre-GST print charge)
  gstAmount        Decimal        @default(0) @db.Decimal(10, 2)
  fileUrl          String?
  fileName         String?
  fileStatus       FileStatus     @default(UPLOAD_PENDING)
  fileRejectReason String?

  @@index([orderId])
  @@index([productId])
  @@index([fileUrl]) // ownership lookup for GET /api/files/[key]
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ───────────────────────── Money ─────────────────────────

model Payment {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  purpose           PaymentPurpose
  method            PaymentMethod
  amount            Decimal        @db.Decimal(10, 2)
  status            PaymentStatus  @default(PENDING)
  orderId           String?        @unique
  order             Order?         @relation(fields: [orderId], references: [id])

  // Bank-transfer proof. Status reads with these: PENDING + no proof = awaiting
  // upload, PENDING + proof = awaiting admin review, FAILED = proof rejected
  // (rejectReason says why; the customer re-uploads), SUCCESS = verified.
  proofUrl        String?   // served via /api/files/[key], owner or admin only
  proofName       String?
  proofUploadedAt DateTime?
  reference       String?   // UTR / transaction reference the customer typed
  rejectReason    String?
  reviewedAt      DateTime?
  reviewedById    String?   // admin who approved or rejected

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([proofUrl]) // /api/files/[key] resolves the owner by URL
}

model Refund {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id])
  amount      Decimal      @db.Decimal(10, 2)
  status      RefundStatus @default(PENDING)
  reason      String?
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([userId])
  @@index([orderId])
  @@index([status]) // admin refund list filters by status
}

// ───────────────────────── Platform ─────────────────────────

// Single-row global configuration. Drives GST, policies,
// and the public business identity shown across the app.
model PlatformSettings {
  id                      String   @id @default("singleton")
  gstPercent              Int      @default(18)
  freeShippingThreshold   Decimal  @default(0) @db.Decimal(10, 2)
  autoRoundPrices         Boolean  @default(false)
  cancellationWindowHours Int      @default(2)
  fileGracePeriod         Boolean  @default(true)
  defaultDpi              String   @default("300 DPI")
  defaultColorProfile     String   @default("CMYK (U.S. Web Coated)")
  standardBleedMm         Decimal  @default(3) @db.Decimal(4, 1)
  businessGstNumber       String?
  // Shown to a customer on their own PAYMENT_PENDING order. Checkout refuses to
  // create orders until the account holder, number and IFSC are filled in.
  bankAccountName         String?
  bankName                String?
  bankAccountNumber       String?
  bankIfsc                String?
  supportPhone            String?
  supportEmail            String?
  socialFacebook          String?
  socialInstagram         String?
  socialTwitter           String?
  socialLinkedin          String?
  updatedAt               DateTime @updatedAt
}

// ───────────────────────── Engagement ─────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt]) // the bell: my notifications, newest first
}
